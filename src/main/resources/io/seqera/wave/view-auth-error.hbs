<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Wave container record">
    <title>Container record</title>
    <link href="https://fonts.googleapis.com/css?family=SF+Pro+Display:400,500,600&display=swap" rel="stylesheet">
    <link href="/assets/style.css" rel="stylesheet">
</head>
<body>

{{> io/seqera/wave/partials/header}}

<div class="container">
    <div class="header-section">
        <h1 class="main-title">Container record</h1>
        <div class="error-div">
            <div class="status-alert error">
                <div class="status-icon"></div>
                <p class="status-message">{{error_message}}</p>
            </div>
        </div>
        {{#if platform_url}}
        <div class="header-section">
            <p><a href="{{platform_url}}">Open Seqera Platform</a></p>
        </div>
        {{/if}}
    </div>
</div>

{{> io/seqera/wave/partials/footer}}

</body>
</html>
