#
# Base URL that will be used to reach the Wave service.
#
WAVE_SERVER_URL=http://localhost:9090

#
# PostgreSQL database used by the Wave service.
#
WAVE_DB_URI=jdbc:postgresql://db:5432/wave
WAVE_DB_USER=wave
WAVE_DB_PASSWORD=wave

#
# Connection URI to connect Wave with the Redis cache
#
REDIS_URI=redis://redis:6379

#
# Connection URL to connect Wave service with Platform instance.
# Replace this variable with your own Platform endpoint.
#
TOWER_ENDPOINT_URL=http://localhost:8000/api

#
# Repositories where Wave pushes the built containers and the build cache.
# Their registry host must have credentials in config.yml 'wave.registries'.
#
WAVE_BUILD_REPO=docker.io/changeme/wave-build
WAVE_BUILD_CACHE=docker.io/changeme/wave-cache

#
# Registry credentials referenced by config.yml
#
DOCKER_USER=
DOCKER_PAT=
