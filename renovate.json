{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "commitMessageSuffix": "[NOTASK]",
  "enabledManagers": [
    "gradle",
    "gradle-wrapper",
    "gomod",
    "npm",
    "dockerfile",
    "docker-compose",
    "pre-commit",
    "github-actions",
    "custom.regex"
  ],
  "schedule": [
    "after 10pm on sunday",
    "before 6am on monday"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "pre-commit": {
    "enabled": true
  },
  "ignorePaths": [
    "**/node_modules/**",
    "docs/**",
    "adr/**",
    "specs/**",
    ".specify/**",
    "src/test/resources/**",
    "src/main/resources/templates/**",
    "scanner/Dockerfile",
    "singularity/Dockerfile",
    "s5cmd/Dockerfile"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Jib base image (jib { from { image = '...' } })",
      "managerFilePatterns": [
        "/(^|/)build\\.gradle$/"
      ],
      "matchStrings": [
        "from\\s*\\{\\s*image\\s*=\\s*['\"](?<depName>[^:'\"\\s]+):(?<currentValue>[^@'\"\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?['\"]"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Micronaut platform version in gradle.properties, read by the Micronaut Gradle plugin and so invisible to the gradle manager",
      "managerFilePatterns": [
        "/^gradle\\.properties$/"
      ],
      "matchStrings": [
        "micronautVersion\\s*=\\s*(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "io.micronaut.platform:micronaut-platform",
      "datasourceTemplate": "maven"
    },
    {
      "customType": "regex",
      "description": "Go image used by the condasplit `make test` target, kept in step with condasplit/Dockerfile",
      "managerFilePatterns": [
        "/^condasplit/Makefile$/"
      ],
      "matchStrings": [
        "golang:(?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)"
      ],
      "depNameTemplate": "golang",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Majors usually need a migration: wait for approval on the Dependency Dashboard",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Wave server libraries and Gradle wrapper. wave-cli is released on its own, so it gets its own PRs",
      "matchManagers": [
        "gradle",
        "gradle-wrapper"
      ],
      "matchFileNames": [
        "!wave-cli/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "gradle minor and patch"
    },
    {
      "description": "wave-cli libraries and Gradle wrapper, kept apart from the server ones so a PR never touches both builds",
      "matchManagers": [
        "gradle",
        "gradle-wrapper"
      ],
      "matchFileNames": [
        "wave-cli/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "wave-cli gradle minor and patch"
    },
    {
      "description": "Micronaut platform BOM and the Micronaut Gradle plugin move together",
      "matchDepNames": [
        "io.micronaut.platform:micronaut-platform",
        "io.micronaut.minimal.application"
      ],
      "groupName": "micronaut"
    },
    {
      "description": "Spock artifacts carry the Groovy line in the version: stay on the Groovy 4 build",
      "matchManagers": [
        "gradle"
      ],
      "matchPackageNames": [
        "org.spockframework:*"
      ],
      "allowedVersions": "/-groovy-4\\.0$/"
    },
    {
      "description": "Guava publishes -jre and -android flavours of each release: stay on -jre",
      "matchManagers": [
        "gradle"
      ],
      "matchPackageNames": [
        "com.google.guava:guava"
      ],
      "allowedVersions": "/-jre$/"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "npm minor and patch"
    },
    {
      "description": "TypeSpec packages are released in lockstep: one PR, or the spec build breaks on a version skew",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "@typespec/*"
      ],
      "groupName": "typespec"
    },
    {
      "matchManagers": [
        "dockerfile",
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "docker images"
    },
    {
      "matchManagers": [
        "pre-commit"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "pre-commit hooks"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "github actions"
    },
    {
      "description": "Any change to condasplit sources needs a condasplit/VERSION bump, or its CI check fails: one PR for all of them, so it's bumped once",
      "matchFileNames": [
        "condasplit/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "condasplit",
      "prBodyNotes": [
        "Bump `condasplit/VERSION` in this PR, otherwise the `check-version` job fails."
      ]
    },
    {
      "description": "The go directive is the minimum Go version for the module, bumped by hand",
      "matchManagers": [
        "gomod"
      ],
      "matchDepNames": [
        "go"
      ],
      "enabled": false
    },
    {
      "description": "Strip the variant suffix (e.g. -al2023-jemalloc) so nf-jdk tags parse as versions instead of getting digest-only updates",
      "matchPackageNames": [
        "cr.seqera.io/public/nf-jdk"
      ],
      "versionCompatibility": "^corretto-(?<version>\\d+\\.\\d+\\.\\d+)-(?<compatibility>.+)$",
      "groupName": "jib base image",
      "pinDigests": true
    },
    {
      "description": "Local dev stack: stay on the Postgres and Redis majors used in production",
      "matchManagers": [
        "docker-compose"
      ],
      "matchPackageNames": [
        "postgres",
        "redis"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Placeholder in lite/docker-compose.yml, not a real image",
      "matchManagers": [
        "docker-compose"
      ],
      "matchPackageNames": [
        "<wave-container-image>"
      ],
      "enabled": false
    }
  ]
}
